{
  "name": "W1 - Contact Intake: Dedupe + AI Triage + Approval",
  "settings": { "executionOrder": "v1" },
  "connections": {
    "Webhook: Contact Form": { "main": [[{ "node": "Normalize Payload", "type": "main", "index": 0 }]] },
    "Normalize Payload": { "main": [[{ "node": "Payload Valid?", "type": "main", "index": 0 }]] },
    "Payload Valid?": { "main": [[{ "node": "Find Idempotency Key", "type": "main", "index": 0 }], [{ "node": "Respond 400 Invalid", "type": "main", "index": 0 }]] },
    "Find Idempotency Key": { "main": [[{ "node": "Already Seen?", "type": "main", "index": 0 }]] },
    "Already Seen?": { "main": [[{ "node": "Respond 200 Duplicate", "type": "main", "index": 0 }], [{ "node": "Insert Idempotency Key", "type": "main", "index": 0 }]] },
    "Respond 200 Duplicate": { "main": [[{ "node": "Mark: duplicate_skipped", "type": "main", "index": 0 }]] },
