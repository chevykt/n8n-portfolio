    "Insert Idempotency Key": { "main": [[{ "node": "Respond 202 Accepted", "type": "main", "index": 0 }]] },
    "Respond 202 Accepted": { "main": [[{ "node": "Claude: Classify + Draft", "type": "main", "index": 0 }]] },
    "Claude: Classify + Draft": { "main": [[{ "node": "Validate Output", "type": "main", "index": 0 }]] },
    "Validate Output": { "main": [[{ "node": "Output Valid?", "type": "main", "index": 0 }]] },
    "Output Valid?": { "main": [[{ "node": "Gmail: Ask for Approval", "type": "main", "index": 0 }], [{ "node": "Claude: Retry (strict JSON)", "type": "main", "index": 0 }]] },
    "Gmail: Ask for Approval": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }]] },
    "Claude: Retry (strict JSON)": { "main": [[{ "node": "Validate Retry", "type": "main", "index": 0 }]] },
    "Validate Retry": { "main": [[{ "node": "Retry Valid?", "type": "main", "index": 0 }]] },
    "Retry Valid?": { "main": [[{ "node": "Gmail: Ask for Approval", "type": "main", "index": 0 }], [{ "node": "Gmail: Manual Review Needed", "type": "main", "index": 0 }]] },
    "Gmail: Manual Review Needed": { "main": [[{ "node": "Mark: manual_review", "type": "main", "index": 0 }]] },
    "Mark: manual_review": { "main": [[{ "node": "Log Run", "type": "main", "index": 0 }]] },
    "Approved?": { "main": [[{ "node": "Gmail: Send Approved Reply", "type": "main", "index": 0 }], [{ "node": "Mark: not_sent", "type": "main", "index": 0 }]] },
    "Gmail: Send Approved Reply": { "main": [[{ "node": "Mark: sent", "type": "main", "index": 0 }]] },
    "Mark: sent": { "main": [[{ "node": "Log Run", "type": "main", "index": 0 }]] },
    "Mark: not_sent": { "main": [[{ "node": "Log Run", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    { "name": "Webhook: Contact Form", "type": "n8n-nodes-base.webhook", "typeVersion": 2.2, "position": [0, 300], "parameters": { "httpMethod": "POST", "path": "contact-intake", "authentication": "headerAuth", "responseMode": "responseNode", "options": {} } },
    { "name": "Normalize Payload", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [220, 300], "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [
      { "id": "n1", "name": "name", "value": "={{ String($json.body?.name ?? $json.name ?? '').trim().slice(0, 100) }}", "type": "string" },
      { "id": "n2", "name": "email", "value": "={{ String($json.body?.email ?? $json.email ?? '').trim().toLowerCase().slice(0, 200) }}", "type": "string" },
      { "id": "n3", "name": "subject", "value": "={{ String($json.body?.subject ?? $json.subject ?? '').trim().slice(0, 200) }}", "type": "string" },
      { "id": "n4", "name": "message", "value": "={{ String($json.body?.message ?? $json.message ?? '').trim().slice(0, 4000) }}", "type": "string" },
      { "id": "n5", "name": "idem_key", "value": "={{ ($json.body?.event_id ?? $json.event_id) ? 'evt:' + String($json.body?.event_id ?? $json.event_id).trim() : 'h:' + [String($json.body?.email ?? '').trim().toLowerCase(), String($json.body?.subject ?? '').trim(), String($json.body?.message ?? '').trim()].join('|').hash('sha256') }}", "type": "string" },
      { "id": "n6", "name": "received_at", "value": "={{ $now.toISO() }}", "type": "string" },
      { "id": "n7", "name": "sandbox_inbox", "value": "you@example.com", "type": "string" }
    ] }, "options": {} } },
    { "name": "Payload Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [440, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [
      { "leftValue": "={{ $json.message }}", "operator": { "type": "string", "operation": "notEmpty", "singleValue": true } },
      { "leftValue": "={{ /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test($json.email) }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
    ], "combinator": "and" } } },
    { "name": "Respond 400 Invalid", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [660, 520], "parameters": { "respondWith": "json", "responseBody": "{ \"status\": \"invalid\", \"error\": \"email and message are required\" }", "options": { "responseCode": 400 } } },
    { "name": "Find Idempotency Key", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [660, 200], "alwaysOutputData": true, "parameters": { "resource": "row", "operation": "get", "dataTableId": { "__rl": true, "mode": "name", "value": "w1_seen_events" }, "matchType": "allConditions", "filters": { "conditions": [{ "keyName": "idem_key", "condition": "eq", "keyValue": "={{ $json.idem_key }}" }] }, "returnAll": false, "limit": 1 } },
    { "name": "Already Seen?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [880, 200], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.id }}", "operator": { "type": "number", "operation": "exists", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Respond 200 Duplicate", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [1100, 40], "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"duplicate\", \"idem_key\": $('Normalize Payload').item.json.idem_key } }}", "options": { "responseCode": 200 } } },
    { "name": "Mark: duplicate_skipped", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [1320, 40], "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [{ "id": "m1", "name": "status", "value": "duplicate_skipped", "type": "string" }, { "id": "m2", "name": "approver_decision", "value": "n/a", "type": "string" }] }, "options": {} } },
    { "name": "Insert Idempotency Key", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [1100, 300], "parameters": { "resource": "row", "operation": "insert", "dataTableId": { "__rl": true, "mode": "name", "value": "w1_seen_events" }, "columns": { "mappingMode": "defineBelow", "value": { "idem_key": "={{ $('Normalize Payload').item.json.idem_key }}", "received_at": "={{ $('Normalize Payload').item.json.received_at }}" }, "schema": [
      { "id": "idem_key", "displayName": "idem_key", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "received_at", "displayName": "received_at", "required": false, "defaultMatch": false, "display": true, "type": "dateTime", "canBeUsedToMatch": true }
    ] }, "options": {} } },
    { "name": "Respond 202 Accepted", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [1320, 300], "parameters": { "respondWith": "json", "responseBody": "={{ { \"status\": \"accepted\", \"idem_key\": $('Normalize Payload').item.json.idem_key } }}", "options": { "responseCode": 202 } } },
    { "name": "Claude: Classify + Draft", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [1540, 300], "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages", "authentication": "predefinedCredentialType", "nodeCredentialType": "anthropicApi", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] }, "sendBody": true, "contentType": "json", "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ model: \"claude-haiku-5-5\", max_tokens: 600, temperature: 0, system: \"You triage contact-form messages for a small business. Respond with ONLY a JSON object, no prose, no code fences, matching exactly: {\\\"intent\\\": one of \\\"sales\\\",\\\"support\\\",\\\"billing\\\",\\\"spam\\\",\\\"other\\\", \\\"urgency\\\": one of \\\"low\\\",\\\"medium\\\",\\\"high\\\", \\\"summary\\\": string of at most 200 characters, \\\"reply_draft\\\": a polite reply of at most 1200 characters signed \\\"The Team\\\"}.\", messages: [{ role: \"user\", content: \"From: \" + $('Normalize Payload').item.json.name + \" <\" + $('Normalize Payload').item.json.email + \">\\nSubject: \" + $('Normalize Payload').item.json.subject + \"\\n\\n\" + $('Normalize Payload').item.json.message }] }) }}", "options": { "timeout": 30000 } } },
    { "name": "Validate Output", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1760, 300], "parameters": { "mode": "runOnceForEachItem", "language": "javaScript", "jsCode": "// First attempt: no earlier token usage.\nconst prev = { tokens_in: 0, tokens_out: 0 };\nconst r = $json;\nconst text = (r.content || []).filter(c => c.type === 'text').map(c => c.text).join('').trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\nlet p = null; let error = null;\ntry { p = JSON.parse(text); } catch (e) { error = 'not_json'; }\nconst INTENTS = ['sales','support','billing','spam','other']; const URG = ['low','medium','high'];\nif (!error) {\n  if (!p || typeof p !== 'object') error = 'not_object';\n  else if (!INTENTS.includes(p.intent)) error = 'bad_intent';\n  else if (!URG.includes(p.urgency)) error = 'bad_urgency';\n  else if (typeof p.summary !== 'string' || p.summary.length > 200) error = 'bad_summary';\n  else if (typeof p.reply_draft !== 'string' || !p.reply_draft.trim() || p.reply_draft.length > 1200) error = 'bad_reply_draft';\n}\nconst out = { valid: !error, error, raw_text: error ? text.slice(0, 500) : '', tokens_in: prev.tokens_in + (r.usage?.input_tokens ?? 0), tokens_out: prev.tokens_out + (r.usage?.output_tokens ?? 0) };\nif (!error) Object.assign(out, { intent: p.intent, urgency: p.urgency, summary: p.summary, reply_draft: p.reply_draft });\nreturn { json: out };" } },
    { "name": "Output Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1980, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.valid }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Claude: Retry (strict JSON)", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [2200, 500], "parameters": { "method": "POST", "url": "https://api.anthropic.com/v1/messages", "authentication": "predefinedCredentialType", "nodeCredentialType": "anthropicApi", "sendHeaders": true, "headerParameters": { "parameters": [{ "name": "anthropic-version", "value": "2023-06-01" }] }, "sendBody": true, "contentType": "json", "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ model: \"claude-haiku-5-5\", max_tokens: 600, temperature: 0, system: \"You triage contact-form messages for a small business. Respond with ONLY a JSON object, no prose, no code fences, matching exactly: {\\\"intent\\\": one of \\\"sales\\\",\\\"support\\\",\\\"billing\\\",\\\"spam\\\",\\\"other\\\", \\\"urgency\\\": one of \\\"low\\\",\\\"medium\\\",\\\"high\\\", \\\"summary\\\": string of at most 200 characters, \\\"reply_draft\\\": a polite reply of at most 1200 characters signed \\\"The Team\\\"}. Your previous answer was not valid. Output ONLY raw JSON. The first character must be { and the last must be }. Keys: intent (sales|support|billing|spam|other), urgency (low|medium|high), summary (<=200 chars), reply_draft (<=1200 chars).\", messages: [{ role: \"user\", content: \"From: \" + $('Normalize Payload').item.json.name + \" <\" + $('Normalize Payload').item.json.email + \">\\nSubject: \" + $('Normalize Payload').item.json.subject + \"\\n\\n\" + $('Normalize Payload').item.json.message }] }) }}", "options": { "timeout": 30000 } } },
    { "name": "Validate Retry", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [2420, 500], "parameters": { "mode": "runOnceForEachItem", "language": "javaScript", "jsCode": "// Retry: add the first attempt's tokens so the logged cost is the total.\nconst prev = $('Validate Output').item.json;\nconst r = $json;\nconst text = (r.content || []).filter(c => c.type === 'text').map(c => c.text).join('').trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, '');\nlet p = null; let error = null;\ntry { p = JSON.parse(text); } catch (e) { error = 'not_json'; }\nconst INTENTS = ['sales','support','billing','spam','other']; const URG = ['low','medium','high'];\nif (!error) {\n  if (!p || typeof p !== 'object') error = 'not_object';\n  else if (!INTENTS.includes(p.intent)) error = 'bad_intent';\n  else if (!URG.includes(p.urgency)) error = 'bad_urgency';\n  else if (typeof p.summary !== 'string' || p.summary.length > 200) error = 'bad_summary';\n  else if (typeof p.reply_draft !== 'string' || !p.reply_draft.trim() || p.reply_draft.length > 1200) error = 'bad_reply_draft';\n}\nconst out = { valid: !error, error, raw_text: error ? text.slice(0, 500) : '', tokens_in: prev.tokens_in + (r.usage?.input_tokens ?? 0), tokens_out: prev.tokens_out + (r.usage?.output_tokens ?? 0) };\nif (!error) Object.assign(out, { intent: p.intent, urgency: p.urgency, summary: p.summary, reply_draft: p.reply_draft });\nreturn { json: out };" } },
    { "name": "Retry Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [2640, 500], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.valid }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Gmail: Manual Review Needed", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [2860, 640], "parameters": { "resource": "message", "operation": "send", "sendTo": "={{ $('Normalize Payload').item.json.sandbox_inbox }}", "subject": "=[W1 manual review] {{ $('Normalize Payload').item.json.subject }}", "emailType": "text", "message": "=Claude returned invalid output twice ({{ $json.error }}). Nothing was sent.\n\nFrom: {{ $('Normalize Payload').item.json.name }} <{{ $('Normalize Payload').item.json.email }}>\nSubject: {{ $('Normalize Payload').item.json.subject }}\n\n{{ $('Normalize Payload').item.json.message }}\n\nRaw model output (truncated):\n{{ $json.raw_text }}", "options": { "appendAttribution": false } } },
    { "name": "Mark: manual_review", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [3080, 640], "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [{ "id": "m1", "name": "status", "value": "manual_review", "type": "string" }, { "id": "m2", "name": "approver_decision", "value": "n/a", "type": "string" }] }, "options": {} } },
    { "name": "Gmail: Ask for Approval", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [2860, 200], "parameters": { "resource": "message", "operation": "sendAndWait", "sendTo": "={{ $('Normalize Payload').item.json.sandbox_inbox }}", "subject": "=[W1 approval] {{ $json.urgency.toUpperCase() }} {{ $json.intent }}: {{ $('Normalize Payload').item.json.subject }}", "message": "=<p><b>From:</b> {{ $('Normalize Payload').item.json.name }} &lt;{{ $('Normalize Payload').item.json.email }}&gt;<br><b>Intent:</b> {{ $json.intent }} | <b>Urgency:</b> {{ $json.urgency }}<br><b>Summary:</b> {{ $json.summary }}</p><p><b>Original message:</b><br>{{ $('Normalize Payload').item.json.message }}</p><hr><p><b>Draft reply:</b><br>{{ $json.reply_draft.replace(/\\n/g, \"<br>\") }}</p>", "responseType": "approval", "approvalOptions": { "values": { "approvalType": "double", "approveLabel": "Approve & send", "disapproveLabel": "Reject" } }, "options": { "limitWaitTime": { "values": { "limitType": "afterTimeInterval", "resumeAmount": 24, "resumeUnit": "hours" } }, "appendAttribution": false } } },
    { "name": "Approved?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [3080, 200], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.data?.approved === true }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Gmail: Send Approved Reply", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [3300, 100], "parameters": { "resource": "message", "operation": "send", "sendTo": "={{ $('Normalize Payload').item.json.sandbox_inbox.replace('@', '+customer@') }}", "subject": "=Re: {{ $('Normalize Payload').item.json.subject }}", "emailType": "text", "message": "=[Sandbox: in production this goes to {{ $('Normalize Payload').item.json.email }}]\n\n{{ ($('Validate Retry').isExecuted ? $('Validate Retry').item.json : $('Validate Output').item.json).reply_draft }}", "options": { "appendAttribution": false } } },
    { "name": "Mark: sent", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [3520, 100], "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [{ "id": "m1", "name": "status", "value": "sent", "type": "string" }, { "id": "m2", "name": "approver_decision", "value": "approved", "type": "string" }] }, "options": {} } },
    { "name": "Mark: not_sent", "type": "n8n-nodes-base.set", "typeVersion": 3.4, "position": [3300, 320], "parameters": { "mode": "manual", "includeOtherFields": false, "assignments": { "assignments": [{ "id": "m1", "name": "status", "value": "not_sent", "type": "string" }, { "id": "m2", "name": "approver_decision", "value": "={{ $json.data?.approved === false ? 'rejected' : 'timeout' }}", "type": "string" }] }, "options": {} } },
    { "name": "Log Run", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [3740, 300], "parameters": { "resource": "row", "operation": "insert", "dataTableId": { "__rl": true, "mode": "name", "value": "w1_runs" }, "columns": { "mappingMode": "defineBelow", "value": {
      "run_id": "={{ $execution.id }}",
      "execution_id": "={{ $execution.id }}",
      "idem_key": "={{ $('Normalize Payload').item.json.idem_key }}",
      "status": "={{ $json.status }}",
      "approver_decision": "={{ $json.approver_decision }}",
      "intent": "={{ $('Validate Output').isExecuted ? (($('Validate Retry').isExecuted ? $('Validate Retry').item.json : $('Validate Output').item.json).intent ?? \"\") : \"\" }}",
      "urgency": "={{ $('Validate Output').isExecuted ? (($('Validate Retry').isExecuted ? $('Validate Retry').item.json : $('Validate Output').item.json).urgency ?? \"\") : \"\" }}",
      "tokens_in": "={{ $('Validate Output').isExecuted ? ($('Validate Retry').isExecuted ? $('Validate Retry').item.json : $('Validate Output').item.json).tokens_in : 0 }}",
      "tokens_out": "={{ $('Validate Output').isExecuted ? ($('Validate Retry').isExecuted ? $('Validate Retry').item.json : $('Validate Output').item.json).tokens_out : 0 }}",
      "received_at": "={{ $('Normalize Payload').item.json.received_at }}",
      "decided_at": "={{ $now.toISO() }}"
    }, "schema": [
      { "id": "run_id", "displayName": "run_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "idem_key", "displayName": "idem_key", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "intent", "displayName": "intent", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "urgency", "displayName": "urgency", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "approver_decision", "displayName": "approver_decision", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "tokens_in", "displayName": "tokens_in", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true },
      { "id": "tokens_out", "displayName": "tokens_out", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true },
      { "id": "received_at", "displayName": "received_at", "required": false, "defaultMatch": false, "display": true, "type": "dateTime", "canBeUsedToMatch": true },
      { "id": "decided_at", "displayName": "decided_at", "required": false, "defaultMatch": false, "display": true, "type": "dateTime", "canBeUsedToMatch": true },
      { "id": "execution_id", "displayName": "execution_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
    ] }, "options": {} } },
    { "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [-32, 208], "parameters": { "content": "## W1: Contact intake with AI triage + approval\n**Trigger:** POST /contact-intake with header X-Intake-Secret.\n**Body:** { event_id?, name, email, subject, message }\n\n1. Rejects requests without the secret (403) and invalid payloads (400).\n2. Idempotency: event_id, or sha256(email|subject|message), checked in data table w1_seen_events. Duplicates return 200 and do nothing.\n3. Claude Haiku (max 600 tokens) returns JSON; a Code node validates it. One retry, then manual review.\n4. A human approves by email before any reply is sent. Replies go only to the sandbox inbox.\n5. Every exit is logged to w1_runs with tokens used.", "color": 5, "width": 520, "height": 360 } }
  ]
}
