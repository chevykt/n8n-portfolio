{
  "name": "W5 - Per-Client Quake Digest (config-driven)",
  "settings": { "executionOrder": "v1", "errorWorkflow": "REPLACE_WITH_W4_ERROR_HANDLER_ID" },
  "connections": {
    "POST /client-digest": { "main": [[{ "node": "Valid client_id?", "type": "main", "index": 0 }]] },
    "Valid client_id?": { "main": [[{ "node": "Load Client Config", "type": "main", "index": 0 }], [{ "node": "Respond 400", "type": "main", "index": 0 }]] },
    "Load Client Config": { "main": [[{ "node": "Known Client?", "type": "main", "index": 0 }]] },
    "Known Client?": { "main": [[{ "node": "Enabled?", "type": "main", "index": 0 }], [{ "node": "Respond 404 Unknown", "type": "main", "index": 0 }]] },
    "Enabled?": { "main": [[{ "node": "Fetch Feed via W4 Retry", "type": "main", "index": 0 }], [{ "node": "Respond 200 Disabled", "type": "main", "index": 0 }]] },
    "Fetch Feed via W4 Retry": { "main": [[{ "node": "Build Client Digest", "type": "main", "index": 0 }]] },
    "Build Client Digest": { "main": [[{ "node": "Respond 200 Digest", "type": "main", "index": 0 }]] },
    "Respond 200 Digest": { "main": [[{ "node": "Gmail: Send Digest to Client", "type": "main", "index": 0 }]] },
    "Gmail: Send Digest to Client": { "main": [[{ "node": "Log to w5_runs", "type": "main", "index": 0 }]] },
    "Respond 200 Disabled": { "main": [[{ "node": "Log to w5_runs", "type": "main", "index": 0 }]] },
    "Respond 404 Unknown": { "main": [[{ "node": "Fail: Unknown Client (alerts W4)", "type": "main", "index": 0 }]] }
  },
  "nodes": [
    { "name": "POST /client-digest", "type": "n8n-nodes-base.webhook", "typeVersion": 2.2, "position": [0, 300], "parameters": { "httpMethod": "POST", "path": "client-digest", "responseMode": "responseNode", "options": {} } },
    { "name": "Valid client_id?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [220, 300], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ /^[a-z0-9-]{1,40}$/.test(String($json.body?.client_id ?? '')) }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Respond 400", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [440, 480], "parameters": { "respondWith": "json", "responseBody": "{ \"status\": \"invalid\", \"error\": \"client_id must be 1-40 chars of a-z, 0-9 or -\" }", "options": { "responseCode": 400 } } },
    { "name": "Load Client Config", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [440, 200], "alwaysOutputData": true, "parameters": { "resource": "row", "operation": "get", "dataTableId": { "__rl": true, "mode": "name", "value": "w5_clients" }, "matchType": "allConditions", "filters": { "conditions": [{ "keyName": "client_id", "condition": "eq", "keyValue": "={{ $json.body.client_id }}" }] }, "returnAll": false, "limit": 1 } },
    { "name": "Known Client?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [660, 200], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.client_id }}", "operator": { "type": "string", "operation": "exists", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Respond 404 Unknown", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [880, 400], "parameters": { "respondWith": "json", "responseBody": "={{ { status: 'unknown_client', client_id: $('POST /client-digest').first().json.body.client_id } }}", "options": { "responseCode": 404 } } },
    { "name": "Fail: Unknown Client (alerts W4)", "type": "n8n-nodes-base.stopAndError", "typeVersion": 1, "position": [1100, 400], "parameters": { "errorType": "errorMessage", "errorMessage": "=Unknown client_id '{{ $('POST /client-digest').first().json.body.client_id }}' - no row in w5_clients" } },
    { "name": "Enabled?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [880, 100], "parameters": { "conditions": { "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" }, "conditions": [{ "leftValue": "={{ $json.enabled }}", "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } } },
    { "name": "Respond 200 Disabled", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [1100, 240], "parameters": { "respondWith": "json", "responseBody": "={{ { status: 'disabled', client_id: $json.client_id } }}", "options": { "responseCode": 200 } } },
    { "name": "Fetch Feed via W4 Retry", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.4, "position": [1100, 40], "parameters": { "source": "database", "workflowId": { "__rl": true, "mode": "id", "value": "REPLACE_WITH_W4_RETRY_WORKFLOW_ID", "cachedResultName": "W4 - HTTP Retry with Backoff (sub-workflow)" }, "workflowInputs": { "mappingMode": "defineBelow", "value": { "url": "https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_week.geojson", "method": "GET", "max_attempts": 3 }, "schema": [
      { "id": "url", "displayName": "url", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "method", "displayName": "method", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "max_attempts", "displayName": "max_attempts", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true }
    ] }, "mode": "once", "options": { "waitForSubWorkflow": true } } },
    { "name": "Build Client Digest", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1320, 40], "parameters": { "mode": "runOnceForAllItems", "language": "javaScript", "jsCode": "const cfg = $('Load Client Config').first().json;\nconst res = $json;\nconst feed = typeof res.body === 'string' ? JSON.parse(res.body) : res.body;\nconst seen = new Set();\nconst quakes = (feed?.features || []).map(f => ({ mag: f.properties?.mag, place: f.properties?.place ?? '', time: new Date(f.properties?.time).toISOString(), lat: f.geometry?.coordinates?.[1], lon: f.geometry?.coordinates?.[0] }))\n  .filter(q => q.mag != null && q.mag >= cfg.min_mag && q.lat >= cfg.min_lat && q.lat <= cfg.max_lat && q.lon >= cfg.min_lon && q.lon <= cfg.max_lon)\n  // Some events are reported by two networks under different ids; same place + minute = same quake.\n  .filter(q => { const k = q.place + '|' + q.time.slice(0, 16); if (seen.has(k)) return false; seen.add(k); return true; })\n  .sort((a, b) => b.mag - a.mag);\nconst lines = quakes.slice(0, cfg.max_items || 5).map(q => 'M' + q.mag + ' - ' + q.place + ' (' + q.time.slice(0, 16).replace('T', ' ') + ' UTC)');\n// The same data, worded per client: the tone column is configuration, not code.\nlet summary;\nif (cfg.tone === 'casual') summary = quakes.length ? 'Hey ' + cfg.name + '! ' + quakes.length + ' quake(s) at M' + cfg.min_mag + '+ in ' + cfg.region_name + ' this week. Biggest: ' + lines[0] + '.' : 'Hey ' + cfg.name + '! Quiet week in ' + cfg.region_name + ': nothing at M' + cfg.min_mag + '+.';\nelse summary = quakes.length ? 'Dear ' + cfg.name + ' team, ' + quakes.length + ' seismic event(s) of magnitude ' + cfg.min_mag + ' or greater were recorded in ' + cfg.region_name + ' during the past 7 days. The strongest was ' + lines[0] + '.' : 'Dear ' + cfg.name + ' team, no seismic events of magnitude ' + cfg.min_mag + ' or greater were recorded in ' + cfg.region_name + ' during the past 7 days.';\nreturn [{ json: { status: 'ok', client_id: cfg.client_id, region_name: cfg.region_name, min_mag: cfg.min_mag, tone: cfg.tone, matched: quakes.length, summary, top: lines } }];" } },
    { "name": "Respond 200 Digest", "type": "n8n-nodes-base.respondToWebhook", "typeVersion": 1.5, "position": [1540, 40], "parameters": { "respondWith": "firstIncomingItem", "options": { "responseCode": 200 } } },
    { "name": "Gmail: Send Digest to Client", "type": "n8n-nodes-base.gmail", "typeVersion": 2.2, "position": [1760, 40], "disabled": true, "onError": "continueRegularOutput", "parameters": { "resource": "message", "operation": "send", "sendTo": "={{ $('Load Client Config').first().json.notify_email }}", "subject": "={{ 'Weekly quake digest: ' + $('Load Client Config').first().json.region_name }}", "emailType": "text", "message": "={{ $('Build Client Digest').first().json.summary + '\\n\\n' + $('Build Client Digest').first().json.top.join('\\n') }}", "options": { "appendAttribution": false } } },
    { "name": "Log to w5_runs", "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [1980, 160], "parameters": { "resource": "row", "operation": "insert", "dataTableId": { "__rl": true, "mode": "name", "value": "w5_runs" }, "columns": { "mappingMode": "defineBelow", "value": {
      "run_at": "={{ $now.toISO() }}",
      "client_id": "={{ $('Load Client Config').first().json.client_id }}",
      "status": "={{ $('Build Client Digest').isExecuted ? 'digest_ready' : 'disabled' }}",
      "matched": "={{ $('Build Client Digest').isExecuted ? $('Build Client Digest').first().json.matched : 0 }}",
      "min_mag": "={{ $('Load Client Config').first().json.min_mag }}",
      "region_name": "={{ $('Load Client Config').first().json.region_name }}",
      "execution_id": "={{ $execution.id }}"
    }, "schema": [
      { "id": "run_at", "displayName": "run_at", "required": false, "defaultMatch": false, "display": true, "type": "dateTime", "canBeUsedToMatch": true },
      { "id": "client_id", "displayName": "client_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "matched", "displayName": "matched", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true },
      { "id": "min_mag", "displayName": "min_mag", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true },
      { "id": "region_name", "displayName": "region_name", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
      { "id": "execution_id", "displayName": "execution_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true }
    ] }, "options": {} } },
    { "name": "Sticky Note", "type": "n8n-nodes-base.stickyNote", "typeVersion": 1, "position": [-32, 208], "parameters": { "content": "## W5: Per-client configuration\nPOST /client-digest `{ \"client_id\": \"acme-ph\" }`\n\nEverything client-specific lives in the **w5_clients** data table: region box, minimum magnitude, tone, max items, email, on/off.\n**A new client = a new row. No workflow edits.**\n\n- Unknown client: 404, then the run fails on purpose so the **W4 Global Error Handler** logs it.\n- Paused client: 200 `disabled`, nothing fetched.\n- Data is fetched through the **W4 retry sub-workflow** (reuse, not copy).", "color": 5, "width": 480, "height": 340 } }
  ]
}
